// GET /cn/logo.png — the Code Ninjas wordmark as a PNG for emails (Gmail won't show the SVG).
// Rendered from storage.googleapis.com/logo-references/CN_Logo.svg on 10/30/2026.
const B64 = "";
const BYTES = Uint8Array.from(atob(B64), (c) => c.charCodeAt(0));

export default async () =>
  new Response(BYTES, { headers: { "Content-Type": "image/png", "Cache-Control": "public, max-age=31536000, immutable" } });

export const config = { path: "/cn/logo.png" };
